# ==============================================================================
# StockPulse Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/StockPulse
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# LiteLLM Proxy / AI Gateway Credentials
LLM_PROVIDER=litellm
LLM_BASE_URL=https://litellm-qc.zycus.net/v1/chat/completions
LLM_API_KEY=your_litellm_api_key_here
LLM_MODEL=qwen-cursor
LLM_PRODUCT=PC1
LLM_COOKIE=your_session_cookie_here
LLM_TIMEOUT_SECONDS=25

# Commerce Strategy Defaults
COMMERCE_STRATEGY_MODE=AI_POWERED
COMMERCE_SPIKE_MULTIPLIER=3.0
